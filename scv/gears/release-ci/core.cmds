dir .
find core/scripts core/tests tests tools -type f -name '*.sh' -exec bash -n {} +
bash core/scripts/check-frontmatter.sh --project-dir .
bash tools/check-readme.sh --profile core .
BASE_REF=develop bash core/scripts/check-privacy.sh
t="$(bash scv/gears/release-ci/related.sh origin/develop)"; if [ -z "$t" ]; then echo "관련 시험 없음"; else d="$(mktemp -d)"; bash core/tests/run-focused.sh --jobs "$JOBS" --dir "$d" $(printf ' --also %s' $t); fi
